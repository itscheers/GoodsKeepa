<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.inventory.controller.SupplierController">

    <top>
        <ToolBar style="-fx-background-color: #1f2a38; -fx-border-color: transparent;">
            <Button text="Додати"     onAction="#onAdd"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
            <Button text="Редагувати" onAction="#onEdit"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
            <Button text="Видалити"   onAction="#onDelete"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
        </ToolBar>
    </top>

    <center>
        <TableView fx:id="table"
                   style="-fx-background-color: #1f2a38; -fx-control-inner-background: #1f2a38;">
            <columns>
                <TableColumn fx:id="colId"      text="ID"        prefWidth="50"/>
                <TableColumn fx:id="colFirst"   text="Ім'я"      prefWidth="150"/>
                <TableColumn fx:id="colLast"    text="Прізвище"  prefWidth="150"/>
                <TableColumn fx:id="colCompany" text="Компанія"  prefWidth="200"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: #1f2a38; -fx-padding: 5;">
            <Label fx:id="lblFooter"
                   text="Курсова Робота"
                   style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>
