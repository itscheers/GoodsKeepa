<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.inventory.controller.CategoryController">

    <!-- Сверху только тулбар -->
    <top>
        <ToolBar style="-fx-background-color: #1f2a38;">
            <Button text="Добавить"    onAction="#onAdd"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
            <Button text="Редактировать" onAction="#onEdit"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
            <Button text="Удалить"     onAction="#onDelete"
                    style="-fx-background-color:black; -fx-text-fill:white;"/>
        </ToolBar>
    </top>

    <!-- Центр — таблица -->
    <center>
        <TableView fx:id="table"
                   style="-fx-background-color: #1f2a38; -fx-control-inner-background: #1f2a38;">
            <columns>
                <TableColumn fx:id="colId"   text="ID"       prefWidth="50"/>
                <TableColumn fx:id="colName" text="Название" prefWidth="200"/>
            </columns>
        </TableView>
    </center>

    <!-- Снизу — линия с временем -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: #1f2a38; -fx-padding: 5;">
            <Label fx:id="lblTime" text="Курсова Робота" style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>
